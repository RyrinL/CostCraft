# Copy this file to db.properties and fill in your own local values.
# db.properties is gitignored so real credentials never get committed.
db.url=jdbc:mysql://localhost:3306/costcraft?useSSL=false&serverTimezone=Asia/Jakarta&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
db.username=YOUR_DB_USER
db.password=YOUR_DB_PASSWORD
db.pool.maximumPoolSize=10
db.pool.minimumIdle=2
db.pool.connectionTimeout=30000
db.pool.idleTimeout=600000
db.pool.maxLifetime=1800000
