<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_1.xsd"
        version="3.1">

  <description>CostCraft EL functions</description>
  <tlib-version>1.0</tlib-version>
  <short-name>cc</short-name>
  <uri>http://costcraft.com/functions</uri>

  <!-- Renders a base-currency (IDR) amount in the user's chosen display currency.
       Delegates to MoneyFormatter -> CurrencyStrategyFactory -> CurrencyFormatStrategy. -->
  <function>
    <description>Format a base-currency amount for the given user's display currency.</description>
    <name>money</name>
    <function-class>com.costcraft.util.MoneyFormatter</function-class>
    <function-signature>java.lang.String format(java.math.BigDecimal, com.costcraft.entity.User)</function-signature>
  </function>

</taglib>
